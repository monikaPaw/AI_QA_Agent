# Copy to .env and fill in the keys you use. Never commit the real .env.
# config/load_model_access.py loads .env automatically; OS env vars win.

# OpenRouter (provider: openrouter)
OPENROUTER_API_KEY=

# Google Gemini (provider: gemini)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI / OpenAI-compatible, incl. Ollama with provider: custom
OPENAI_API_KEY=
